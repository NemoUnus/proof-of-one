<!-- Proof of One (app v0.17, review F4): nothing of this app is copied, neither to a cloud backup
     nor to a new phone during a phone-to-phone transfer. The members' files could not be opened
     there anyway (their keys stay in this phone's secure hardware); a membership moves to a new
     phone by restoring it with the passport and the password. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
