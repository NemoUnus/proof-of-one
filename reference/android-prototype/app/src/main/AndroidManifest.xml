<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />
    <!-- The face check test asks the phone's camera app for one selfie (no camera permission). -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    </queries>
    <!-- Internet: the enrolment screen talks to the pilot's enrolment service; the registration
         and the poll screen talk to the pilot's relay (EnrolService.kt). The passport reading
         and face check screens send nothing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:supportsRtl="true"
        android:label="Proof of One"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ProverActivity" android:exported="false" />
        <activity android:name=".FaceActivity" android:exported="false" />
        <activity android:name=".DocProofActivity" android:exported="false" />
        <activity android:name=".EnrolActivity" android:exported="false" />
        <activity android:name=".PollsActivity" android:exported="false" />
        <activity android:name=".VoteActivity" android:exported="false" />
        <activity android:name=".FaceCheckActivity" android:exported="false" />
        <!-- Lets the camera app write the selfie into this app's cache; deleted once read. -->
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
