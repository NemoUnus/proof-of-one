pragma solidity ^0.8.24;

import {BabyJubjub} from "./BabyJubjub.sol";

interface IPoseidon3 { function poseidon(uint256[3] calldata input) external pure returns (uint256); }
interface IPoseidon5 { function poseidon(uint256[5] calldata input) external pure returns (uint256); }

interface IIdentityRegistry {
    function root() external view returns (uint256);
    function leafCount() external view returns (uint256);
}

interface IRevocationRegistry {
    function root() external view returns (uint256);
    function previousRoot() external view returns (uint256);
    function rootSince() external view returns (uint64);
    function revokedCount() external view returns (uint256);
}

/// @notice Groth16 verifier for the ballot circuit (generated by snarkjs).
interface IBallotVerifier {
    function verifyProof(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[18] calldata pub
    ) external view returns (bool);
}

/// @notice Groth16 verifier for the tally proof π_tally (tally-circuit/, generated by snarkjs).
interface ITallyVerifier {
    function verifyProof(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[38] calldata pub
    ) external view returns (bool);
}

/// @notice Batched verifier for many ballot proofs of one poll (BallotBatchVerifier.sol).
interface IBallotBatchVerifier {
    struct Proof { uint256[2] a; uint256[2][2] b; uint256[2] c; }
    function verifyBallots(
        uint256 pollHash,
        uint256[] calldata nfs,
        uint256[16][] calldata cts,
        Proof[] calldata proofs
    ) external view returns (bool);
}

/// @title Proof of One — polls, ballots and results (reference implementation)
/// @notice Combines the roles of PollRegistry, PollAnswers and ResultsRegistry from
///         docs/specs/contracts-v0.1.md, for a 4-option poll without breakdown cells.
/// @dev Snapshot roots are read from IdentityRegistry and RevocationRegistry when a poll
///      is created. The contract keeps the homomorphic sum of the counted ballots itself
///      (a re-vote subtracts the replaced ballot) and accepts a result only with a tally
///      proof π_tally that the counts are the correct decryption of those totals, checked
///      in full at publication (Decision Log #53; docs/specs/on-chain-tally-verification-v0.1.md). NOT IMPLEMENTED HERE (see the
///      spec): trustee signatures on the tally key and on results, the relay (ERC-4337),
///      and recursive ballot aggregation. Reference code; not audited.
contract ProofOfOnePolls {
    uint256 public constant K = 4;
    uint256 public constant SNARK_FIELD = 21888242871839275222246405745257275088548364400416034343698204186575808495617;
    uint64 public constant MIN_DURATION = 48 hours;
    uint64 public constant WITHHOLD_DEADLINE = 14 days;
    uint8 public constant MAX_TRUSTEES = 32;            // bounds the gas of createPoll
    /// @notice The tally proof is one circuit per threshold; this reference has the one for t = 3.
    uint8 public constant TALLY_T = 3;

    /// @dev Published and Rejected are no longer reached: a result is checked in full when it is
    ///      published and is final at once (Decision Log #53). The values keep their numbers.
    enum State { None, Open, Published, Final, Withheld, Rejected }

    struct Poll {
        address creator;
        uint256 idRoot;
        uint256 revRoot;
        uint256 eligible;
        uint256[2] tallyPK;
        uint32 maxBirthDay;     // eligible if born on or before this day (days since 1900-01-01)
        uint32 minBirthDay;     // and on or after this day; 0 = no upper age limit (Decision #37)
        uint32 minExpiryMonth;
        uint32 requiredNat;
        uint16 maxRevotes;
        uint64 openTime;
        uint64 closeTime;
        bytes32 metadataHash;
        uint256 pollHash;   // binds the nine per-poll values the ballot proof uses, with the revocation root at creation
        bytes32 trusteeKeysHash; // keccak256(abi.encode(uint256[2][] PK_i)), trustee i at position i−1
        uint8 threshold;    // t: partial decryptions needed
        uint8 trustees;     // n
        uint64 resultDeadline; // last moment to publish
        State state;
    }

    struct Result {
        uint256[K] counts;
        bytes32 finalBallotChain;
        bytes32 transcriptHash;
        bytes32 archiveHash;
        uint256[2][K] D;        // combined decryption D_j = Σ λ_i·D_ij (affine)
        uint64 publishedAt;
    }

    IBallotVerifier public immutable verifier;
    /// @notice A ballot proves non-revocation against the current revocation root, so that a
    ///         revoked identity cannot vote in polls that are already open (Decision Log #52).
    ///         A proof made against the root before the latest revocation is still accepted for
    ///         this long, so that a revocation does not void ballots being sent at that moment.
    uint64 public constant REVOCATION_GRACE = 10 minutes;
    /// @notice pollHash of a poll for a given revocation root (the other eight values fixed).
    mapping(uint256 => mapping(uint256 => uint256)) public pollHashAt;
    mapping(uint256 => uint256) internal _policyHash;   // h2 of the pollHash, per poll
    ITallyVerifier public immutable tallyVerifier;
    IBallotBatchVerifier public immutable batchVerifier;
    IIdentityRegistry public immutable identity;
    IRevocationRegistry public immutable revocation;
    IPoseidon3 public immutable poseidon3;
    IPoseidon5 public immutable poseidon5;

    /// @notice What a poll creator chooses. Snapshot roots and the eligible count are NOT
    ///         chosen by the creator; they are read from the registries.
    struct PollParams {
        uint256[2] tallyPK;
        uint32 maxBirthDay;     // eligible if born on or before this day (days since 1900-01-01)
        uint32 minBirthDay;     // and on or after this day; 0 = no upper age limit (Decision #37)
        uint32 minExpiryMonth;
        uint32 requiredNat;
        uint16 maxRevotes;
        uint64 openTime;
        uint64 closeTime;
        bytes32 metadataHash;
        uint256[2][] trusteeKeys; // public shares PK_i from key generation, trustee i at position i−1
        uint8 threshold;
        uint64 sampleThreshold;   // 0 = open poll; otherwise a sampled poll with this invitation threshold
    }

    /// @notice Sampled polls (docs/specs/cost-of-large-polls-v0.1.md §2, Decision #44). A member
    ///         is invited if the top 64 bits of ticket = Poseidon(13, nf, seed) are below the
    ///         threshold. The ticket uses the poll's nullifier, which only the member can compute
    ///         before voting, so nobody else can tell who was invited; once a member votes, their
    ///         nf is public and anyone can check the invitation, so the contract checks it and
    ///         the ballot proof needs no change.
    struct Sampling {
        uint64 threshold;       // 0 = open poll
        uint64 seedBlock;       // block whose hash fixes the seed (after the snapshot)
        bool seedFixed;
        uint256 seed;
    }
    mapping(uint256 => Sampling) public sampling;
    uint64 public constant SEED_DELAY_BLOCKS = 2;
    uint256 internal constant TAG_SAMPLE = 13;
    uint256 public pollCount;
    mapping(uint256 => Poll) private _polls;
    mapping(uint256 => Result) private _results;
    struct Slot { bytes28 ballotHash; uint32 count; }         // one storage slot per nullifier
    struct Counters { uint128 distinctVoters; uint128 totalSubmissions; } // one slot per poll
    mapping(uint256 => mapping(uint256 => Slot)) public ballots; // pollId => nf => latest ballot
    mapping(uint256 => bytes32) public ballotChain;
    mapping(uint256 => Counters) private _counters;
    /// @dev Running homomorphic sum of the counted ballots: affine (x, y) of A_0..A_3 then
    ///      B_0..B_3, each coordinate stored PLUS ONE. The offset keeps every slot non-zero,
    ///      so the poll creator pays for creating the 16 slots (createPoll) and every
    ///      ballot pays the same, lower price for updating them.
    mapping(uint256 => uint256[16]) private _agg;

    /// @notice A poll began accepting proofs against this revocation root.
    event PollRevocationRoot(uint256 indexed pollId, uint256 revRoot, uint256 pollHash);
    event PollCreated(uint256 indexed pollId, address creator, uint256 idRoot, uint256 revRoot, uint64 openTime, uint64 closeTime, bytes32 metadataHash);
    event Ballot(uint256 indexed pollId, uint256 indexed nf, uint256[16] ciphertexts, uint16 count);
    event ResultPublished(uint256 indexed pollId, uint256[K] counts, uint256[2][K] D, uint256[] trustees, bytes32 transcriptHash, bytes32 archiveHash);
    event SampledPoll(uint256 indexed pollId, uint64 threshold, uint64 seedBlock);
    event SeedFixed(uint256 indexed pollId, uint256 seed);
    event TrusteeKeys(uint256 indexed pollId, uint256[2][] keys, uint8 threshold);
    event ResultFinal(uint256 indexed pollId);
    event ResultWithheld(uint256 indexed pollId);

    error InvalidTallyKey();
    error BadTimes();
    error PollNotOpen();
    error SeedNotFixed();
    error NotInvited();
    error NotSampled();
    error SeedTooEarly();
    error RevoteCapReached();
    error InvalidProof();
    error NotClosed();
    error BadState();
    error ChainMismatch();
    error CountsMismatch();
    error TooManyVoters();
    error DeadlineNotReached();
    error BadBatch();
    error BadPrevious();
    error BadTrustees();
    error BadPartials();
    error DecryptionMismatch();
    error InvalidTallyProof();

    constructor(
        IBallotVerifier verifier_,
        IBallotBatchVerifier batchVerifier_,
        IIdentityRegistry identity_,
        IRevocationRegistry revocation_,
        IPoseidon3 p3,
        IPoseidon5 p5,
        ITallyVerifier tallyVerifier_
    ) {
        verifier = verifier_;
        tallyVerifier = tallyVerifier_;
        batchVerifier = batchVerifier_;
        identity = identity_;
        revocation = revocation_;
        poseidon3 = p3;
        poseidon5 = p5;
    }

    function distinctVoters(uint256 pollId) public view returns (uint256) { return _counters[pollId].distinctVoters; }
    function totalSubmissions(uint256 pollId) public view returns (uint256) { return _counters[pollId].totalSubmissions; }

    // ------------------------------------------------------------------ polls

    function createPoll(PollParams calldata p) external returns (uint256 pollId) {
        // The tally key is the only externally chosen curve point the proof relies on.
        if (!BabyJubjub.isInSubgroup(p.tallyPK[0], p.tallyPK[1])) revert InvalidTallyKey();
        if (p.closeTime < p.openTime + MIN_DURATION) revert BadTimes();
        _checkTrustees(p);
        pollId = ++pollCount;
        Poll storage s = _polls[pollId];
        s.creator = msg.sender;
        // Membership snapshot: fixed for the life of the poll (spec §3, contracts §6).
        s.idRoot = identity.root();
        s.revRoot = revocation.root();
        s.eligible = identity.leafCount() - revocation.revokedCount();
        s.tallyPK = p.tallyPK;
        s.maxBirthDay = p.maxBirthDay;
        s.minBirthDay = p.minBirthDay;
        s.minExpiryMonth = p.minExpiryMonth;
        s.requiredNat = p.requiredNat;
        s.maxRevotes = p.maxRevotes == 0 ? 10 : p.maxRevotes;
        s.openTime = p.openTime;
        s.closeTime = p.closeTime;
        s.metadataHash = p.metadataHash;
        s.trusteeKeysHash = keccak256(abi.encode(p.trusteeKeys));
        s.threshold = p.threshold;
        s.trustees = uint8(p.trusteeKeys.length);
        s.resultDeadline = p.closeTime + WITHHOLD_DEADLINE;
        emit TrusteeKeys(pollId, p.trusteeKeys, p.threshold);
        if (p.sampleThreshold != 0) {
            uint64 sb = uint64(block.number) + SEED_DELAY_BLOCKS;
            sampling[pollId] = Sampling(p.sampleThreshold, sb, false, 0);
            emit SampledPoll(pollId, p.sampleThreshold, sb);
        }
        uint256[16] storage g = _agg[pollId];
        for (uint256 q = 0; q < 8; q++) { g[2 * q] = 1; g[2 * q + 1] = 2; } // identity (0, 1), offset by one
        // pollHash = Poseidon(7, Poseidon(idRoot, revRoot, pollId, PK.x, PK.y),
        //                       Poseidon(maxBirthDay, minBirthDay, minExpiryMonth, requiredNat, contextHash))
        uint256 h1 = poseidon5.poseidon([s.idRoot, s.revRoot, pollId, p.tallyPK[0], p.tallyPK[1]]);
        uint256 h2 = poseidon5.poseidon([uint256(p.maxBirthDay), uint256(p.minBirthDay), uint256(p.minExpiryMonth), uint256(p.requiredNat), contextHash(pollId)]);
        s.pollHash = poseidon3.poseidon([uint256(7), h1, h2]);
        _policyHash[pollId] = h2;
        pollHashAt[pollId][s.revRoot] = s.pollHash;
        s.state = State.Open;
        emit PollCreated(pollId, msg.sender, s.idRoot, s.revRoot, p.openTime, p.closeTime, p.metadataHash);
    }

    /// @dev The trustee keys must be valid subgroup points and consistent with the tally key:
    ///      the Lagrange combination of the first t keys must equal tallyPK, so that a
    ///      correct decryption is possible and every partial decryption can be checked.
    ///      (Consistency of every t-subset needs the key-generation commitments; see the
    ///      trustee key generation spec. Not checked here.)
    function _checkTrustees(PollParams calldata p) internal view {
        uint256 n = p.trusteeKeys.length;
        uint256 t = p.threshold;
        if (t == 0 || t > n || n > MAX_TRUSTEES) revert BadTrustees();
        if (t != TALLY_T) revert BadTrustees(); // the tally proof exists for this threshold only
        uint256[] memory idx = new uint256[](t);
        for (uint256 i = 0; i < t; i++) idx[i] = i + 1;
        (uint256 X, uint256 Y, uint256 Z) = (0, 0, 0);
        for (uint256 i = 0; i < n; i++) {
            uint256[2] calldata K_ = p.trusteeKeys[i];
            if (!BabyJubjub.isInSubgroup(K_[0], K_[1])) revert BadTrustees();
            if (i < t) {
                (uint256 Xi, uint256 Yi, uint256 Zi) = BabyJubjub.mul(K_[0], K_[1], _lagrange0(idx, i));
                (X, Y, Z) = BabyJubjub.add(X, Y, Z, Xi, Yi, Zi);
            }
        }
        if (!BabyJubjub.eq(X, Y, Z, p.tallyPK[0], p.tallyPK[1], 1)) revert BadTrustees();
    }

    function getPoll(uint256 pollId) external view returns (Poll memory) {
        return _polls[pollId];
    }

    /// @notice Context the ballot proof must be bound to: this chain, this contract, this poll.
    function contextHash(uint256 pollId) public view returns (uint256) {
        return uint256(keccak256(abi.encode(block.chainid, address(this), pollId))) % SNARK_FIELD;
    }

    // ---------------------------------------------------------------- ballots

    /// @notice Submit one ballot directly. Always available, so no aggregator can censor.
    /// @param ct ciphertexts in circuit order: A_0..A_3 (x, y) then B_0..B_3 (x, y)
    /// @param prev for a re-vote, the ballot it replaces (as in its Ballot event), so the
    ///        contract can subtract it from the running sum; ignored for a first ballot
    function vote(
        uint256 pollId,
        uint256 nf,
        uint256[16] calldata ct,
        uint256[16] calldata prev,
        uint256[2] calldata pa,
        uint256[2][2] calldata pb,
        uint256[2] calldata pc
    ) external {
        Poll storage p = _openPoll(pollId);
        // Public inputs: the poll's own pollHash, the nullifier and the ciphertexts.
        uint256[18] memory pub;
        (uint256 cur, uint256 prv) = _pollHashes(pollId, p);
        pub[0] = cur;
        pub[1] = nf;
        for (uint256 i = 0; i < 16; i++) pub[2 + i] = ct[i];
        if (!verifier.verifyProof(pa, pb, pc, pub)) {
            pub[0] = prv;
            if (prv == 0 || !verifier.verifyProof(pa, pb, pc, pub)) revert InvalidProof();
        }
        if (!invited(pollId, nf)) revert NotInvited();

        Counters memory cnt = _counters[pollId];
        uint256[24] memory agg = _loadAgg(pollId);
        (bytes32 chain, bool revote, bytes28 prevHash) = _record(pollId, p.maxRevotes, nf, ct, cnt, ballotChain[pollId], agg);
        if (revote) _subtract(prevHash, prev, agg);
        ballotChain[pollId] = chain;
        _counters[pollId] = cnt;
        _storeAgg(pollId, agg);
    }

    /// @notice Submit many ballots of one poll in one transaction (anyone may call, for
    ///         example a relay). All proofs are checked together with n + 3 pairings; if any
    ///         proof is invalid the whole batch is rejected, so a relay must check each
    ///         proof off-chain first. Ballots are recorded in the given order, exactly as
    ///         if submitted one by one, so the ballot chain and events are unchanged.
    /// @param prevs the replaced ballots of the re-votes in this batch, in batch order
    function voteBatch(
        uint256 pollId,
        uint256[] calldata nfs,
        uint256[16][] calldata cts,
        IBallotBatchVerifier.Proof[] calldata proofs,
        uint256[16][] calldata prevs
    ) external {
        Poll storage p = _openPoll(pollId);
        if (nfs.length == 0 || nfs.length != cts.length || nfs.length != proofs.length) revert BadBatch();
        // Nullifiers must be strictly increasing: no nullifier twice in one batch, so a relay
        // cannot choose which of a member's answers counts (whitepaper v0.9, 8.5). Re-votes go
        // in separate transactions, ordered by the ledger. One comparison per ballot.
        for (uint256 i = 1; i < nfs.length; i++) if (nfs[i] <= nfs[i - 1]) revert BadBatch();
        (uint256 cur, uint256 prv) = _pollHashes(pollId, p);
        if (!batchVerifier.verifyBallots(cur, nfs, cts, proofs) && (prv == 0 || !batchVerifier.verifyBallots(prv, nfs, cts, proofs))) revert InvalidProof();
        if (sampling[pollId].threshold != 0) for (uint256 i = 0; i < nfs.length; i++) if (!invited(pollId, nfs[i])) revert NotInvited();

        Counters memory cnt = _counters[pollId];
        bytes32 chain = ballotChain[pollId];
        uint16 cap = p.maxRevotes;
        uint256[24] memory agg = _loadAgg(pollId);   // read once, written once per batch
        uint256 r;
        for (uint256 i = 0; i < nfs.length; i++) {
            bool revote;
            bytes28 prevHash;
            (chain, revote, prevHash) = _record(pollId, cap, nfs[i], cts[i], cnt, chain, agg);
            if (revote) {
                if (r >= prevs.length) revert BadPrevious();
                _subtract(prevHash, prevs[r++], agg);
            }
        }
        if (r != prevs.length) revert BadPrevious();
        ballotChain[pollId] = chain;
        _counters[pollId] = cnt;
        _storeAgg(pollId, agg);
    }

    /// @dev The pollHash for the current revocation root and, within the grace period after
    ///      a revocation, for the root before it (0 otherwise). Computed once per root and poll.
    function _pollHashes(uint256 pollId, Poll storage p) internal returns (uint256 cur, uint256 prv) {
        cur = _pollHashFor(pollId, p, revocation.root());
        // The root before is accepted only if it is not older than the poll's snapshot: if the
        // root has not changed since the poll was created, there is nothing to grant.
        uint256 now_ = revocation.root();
        if (now_ != p.revRoot && block.timestamp < uint256(revocation.rootSince()) + REVOCATION_GRACE) prv = _pollHashFor(pollId, p, revocation.previousRoot());
    }

    function _pollHashFor(uint256 pollId, Poll storage p, uint256 revRoot) internal returns (uint256 h) {
        h = pollHashAt[pollId][revRoot];
        if (h == 0) {
            uint256 h1 = poseidon5.poseidon([p.idRoot, revRoot, pollId, p.tallyPK[0], p.tallyPK[1]]);
            h = poseidon3.poseidon([uint256(7), h1, _policyHash[pollId]]);
            pollHashAt[pollId][revRoot] = h;
            emit PollRevocationRoot(pollId, revRoot, h);
        }
    }

    function _openPoll(uint256 pollId) internal view returns (Poll storage p) {
        p = _polls[pollId];
        if (p.state != State.Open || block.timestamp < p.openTime || block.timestamp >= p.closeTime) revert PollNotOpen();
        Sampling storage sm = sampling[pollId];
        if (sm.threshold != 0 && !sm.seedFixed) revert SeedNotFixed();
    }

    /// @notice Fixes the seed of a sampled poll from the hash of a block that did not exist
    ///         when the poll (and its membership snapshot) was created. Anyone may call it.
    /// @dev REFERENCE SIMPLIFICATION: a block hash can be biased by the block's producer,
    ///      who may withhold a block whose hash it dislikes. Production uses an unbiasable
    ///      randomness beacon (for example drand), verified on-chain. If the block is more
    ///      than 256 blocks old, its hash is no longer available and a new block is chosen.
    function fixSeed(uint256 pollId) external {
        Sampling storage sm = sampling[pollId];
        if (sm.threshold == 0) revert NotSampled();
        if (sm.seedFixed) revert BadState();
        if (block.number <= sm.seedBlock) revert SeedTooEarly();
        bytes32 bh = blockhash(sm.seedBlock);
        if (bh == bytes32(0)) { sm.seedBlock = uint64(block.number) + SEED_DELAY_BLOCKS; return; }
        sm.seed = uint256(keccak256(abi.encode(bh, pollId))) % SNARK_FIELD;
        sm.seedFixed = true;
        emit SeedFixed(pollId, sm.seed);
    }

    /// @notice Whether the member with nullifier nf is invited to sampled poll pollId.
    function invited(uint256 pollId, uint256 nf) public view returns (bool) {
        Sampling storage sm = sampling[pollId];
        if (sm.threshold == 0) return true;
        uint256 t = poseidon3.poseidon([TAG_SAMPLE, nf, sm.seed]);
        return (t >> 190) < sm.threshold;
    }

    /// @dev Records one verified ballot and adds it to the running sum; returns the
    ///      extended ballot chain, whether it replaces an earlier ballot, and the hash of
    ///      the replaced ballot, which the caller checks and subtracts (_subtract).
    function _record(uint256 pollId, uint16 cap, uint256 nf, uint256[16] calldata ct, Counters memory cnt, bytes32 chain, uint256[24] memory agg)
        internal returns (bytes32, bool revote, bytes28 prevHash)
    {
        Slot memory slot = ballots[pollId][nf];
        if (slot.count >= cap) revert RevoteCapReached();
        revote = slot.count != 0;
        prevHash = slot.ballotHash;
        if (!revote) cnt.distinctVoters++;
        bytes32 h = _ctHash(ct);
        uint32 n = slot.count + 1;
        ballots[pollId][nf] = Slot(bytes28(h), n);
        chain = keccak256(abi.encodePacked(chain, nf, h, uint256(cnt.totalSubmissions)));
        cnt.totalSubmissions++;
        _accumulate(agg, ct, false);
        emit Ballot(pollId, nf, ct, uint16(n));
        return (chain, revote, prevHash);
    }

    /// @dev Checks that `prev` is the ballot this re-vote replaces and subtracts it.
    function _subtract(bytes28 prevHash, uint256[16] calldata prev, uint256[24] memory agg) internal pure {
        if (bytes28(_ctHash(prev)) != prevHash) revert BadPrevious();
        _accumulate(agg, prev, true);
    }

    /// @dev Same encoding as the reference tally: per option j, A_j.x, A_j.y, B_j.x, B_j.y.
    function _ctHash(uint256[16] calldata ct) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked(
            ct[0], ct[1], ct[8], ct[9], ct[2], ct[3], ct[10], ct[11],
            ct[4], ct[5], ct[12], ct[13], ct[6], ct[7], ct[14], ct[15]));
    }

    /// @dev agg += ct (or −ct). Each of the 8 points (x, y) is affine; −(x, y) = (−x, y).
    function _accumulate(uint256[24] memory agg, uint256[16] calldata ct, bool negate) internal pure {
        for (uint256 q = 0; q < 8; q++) {
            uint256 x = ct[2 * q];
            if (negate && x != 0) x = BabyJubjub.P - x;
            (agg[3 * q], agg[3 * q + 1], agg[3 * q + 2]) =
                BabyJubjub.add(agg[3 * q], agg[3 * q + 1], agg[3 * q + 2], x, ct[2 * q + 1], 1);
        }
    }

    /// @notice The running sum (A_j, B_j) of the counted ballots, affine:
    ///         A_0..A_3 then B_0..B_3, each (x, y).
    function aggregate(uint256 pollId) public view returns (uint256[2][8] memory out) {
        uint256[16] storage g = _agg[pollId];
        for (uint256 q = 0; q < 8; q++) (out[q][0], out[q][1]) = (g[2 * q] - 1, g[2 * q + 1] - 1);
    }

    /// @dev Stored affine sum → projective working copy (Z = 1).
    function _loadAgg(uint256 pollId) internal view returns (uint256[24] memory a) {
        uint256[16] storage g = _agg[pollId];
        for (uint256 q = 0; q < 8; q++) (a[3 * q], a[3 * q + 1], a[3 * q + 2]) = (g[2 * q] - 1, g[2 * q + 1] - 1, 1);
    }

    /// @dev Projective working copy → stored affine sum, with one inversion for all eight
    ///      points (Montgomery's trick). Z ≠ 0 for every point the addition formula yields.
    function _storeAgg(uint256 pollId, uint256[24] memory a) internal {
        uint256 P = BabyJubjub.P;
        uint256[8] memory pre;
        uint256 acc = 1;
        for (uint256 q = 0; q < 8; q++) { pre[q] = acc; acc = mulmod(acc, a[3 * q + 2], P); }
        uint256 inv = BabyJubjub.expmod(acc, P - 2, P);
        uint256[16] storage g = _agg[pollId];
        for (uint256 q = 8; q > 0; q--) {
            uint256 zi = mulmod(inv, pre[q - 1], P);           // 1 / Z_q
            inv = mulmod(inv, a[3 * (q - 1) + 2], P);
            g[2 * (q - 1)] = mulmod(a[3 * (q - 1)], zi, P) + 1;
            g[2 * (q - 1) + 1] = mulmod(a[3 * (q - 1) + 1], zi, P) + 1;
        }
    }

    // ---------------------------------------------------------------- results

    /// @notice Publishes the result of a closed poll. Everything is checked here, so that a
    ///         wrong result can never become final because nobody challenged it (Decision
    ///         Log #53; second-model review of whitepaper v1.0, finding 3). The contract checks
    ///         the ballot chain, Σ counts = distinct voters ≤ eligible, the trustee keys against
    ///         the commitment made at poll creation, and t distinct trustees in increasing
    ///         order. The tally proof π_tally proves the rest: every trustee's Chaum–Pedersen
    ///         proof for every option, the Lagrange combination D_j = Σ λ_i·D_ij, and
    ///         B_j = D_j + count_j·G, against the contract's own running totals. A result that
    ///         passes is final at once.
    /// @dev Reference simplification: anyone may publish (the spec requires t-of-n trustee
    ///      signatures). Since only a correct result can pass, this costs no correctness.
    ///      The partial decryptions themselves go into the published transcript (archive).
    function publish(uint256 pollId, Result calldata r, uint256[] calldata trustees, uint256[2][] calldata keys,
        uint256[2] calldata a, uint256[2][2] calldata b, uint256[2] calldata c) external
    {
        Poll storage p = _polls[pollId];
        if (p.state != State.Open) revert BadState();
        if (block.timestamp < p.closeTime) revert NotClosed();
        if (block.timestamp >= p.resultDeadline) revert BadState();
        if (r.finalBallotChain != ballotChain[pollId]) revert ChainMismatch();
        uint256 sum;
        for (uint256 j = 0; j < K; j++) sum += r.counts[j];
        if (sum != distinctVoters(pollId)) revert CountsMismatch();      // one-hot ballots
        if (distinctVoters(pollId) > p.eligible) revert TooManyVoters(); // bound check (C5)
        if (keccak256(abi.encode(keys)) != p.trusteeKeysHash) revert BadTrustees();
        if (trustees.length != TALLY_T) revert BadPartials();
        uint256[] memory idx = new uint256[](TALLY_T);
        for (uint256 i = 0; i < TALLY_T; i++) {
            idx[i] = trustees[i];
            if (idx[i] == 0 || idx[i] > p.trustees || (i > 0 && idx[i] <= idx[i - 1])) revert BadPartials();
        }
        if (!tallyVerifier.verifyProof(a, b, c, _tallyInputs(pollId, r, keys, idx))) revert InvalidTallyProof();
        Result storage s = _results[pollId];
        s.counts = r.counts;
        s.finalBallotChain = r.finalBallotChain;
        s.transcriptHash = r.transcriptHash;
        s.archiveHash = r.archiveHash;
        s.D = r.D;
        s.publishedAt = uint64(block.timestamp);
        p.state = State.Final;
        emit ResultPublished(pollId, r.counts, r.D, trustees, r.transcriptHash, r.archiveHash);
        emit ResultFinal(pollId);
    }

    /// @dev Public inputs of π_tally, in the circuit's order: pollId, A_0..A_3, B_0..B_3,
    ///      counts, the t trustee keys, their Lagrange coefficients, D_0..D_3.
    function _tallyInputs(uint256 pollId, Result calldata r, uint256[2][] calldata keys, uint256[] memory idx)
        internal view returns (uint256[38] memory pub)
    {
        pub[0] = pollId;
        uint256[16] storage g = _agg[pollId];
        for (uint256 q = 0; q < 16; q++) pub[1 + q] = g[q] - 1;   // A_j then B_j, affine
        for (uint256 j = 0; j < K; j++) {
            pub[17 + j] = r.counts[j];
            pub[30 + 2 * j] = r.D[j][0];
            pub[31 + 2 * j] = r.D[j][1];
        }
        for (uint256 i = 0; i < TALLY_T; i++) {
            pub[21 + 2 * i] = keys[idx[i] - 1][0];
            pub[22 + 2 * i] = keys[idx[i] - 1][1];
            pub[27 + i] = _lagrange0(idx, i);
        }
    }

    /// @dev Lagrange coefficient at 0 for idx[i] over the index set idx, mod ℓ.
    function _lagrange0(uint256[] memory idx, uint256 i) internal view returns (uint256) {
        uint256 L = BabyJubjub.ORDER;
        uint256 num = 1;
        uint256 den = 1;
        uint256 xi = idx[i];
        for (uint256 k = 0; k < idx.length; k++) {
            if (k == i) continue;
            uint256 xk = idx[k];
            num = mulmod(num, xk, L);
            den = mulmod(den, xk > xi ? xk - xi : L - (xi - xk), L);
        }
        return mulmod(num, BabyJubjub.expmod(den, L - 2, L), L);
    }

    /// @notice Anyone may mark a poll whose result was not published in time.
    function markWithheld(uint256 pollId) external {
        Poll storage p = _polls[pollId];
        if (p.state != State.Open) revert BadState();
        if (block.timestamp < p.resultDeadline) revert DeadlineNotReached();
        p.state = State.Withheld;
        emit ResultWithheld(pollId);
    }

    function getResult(uint256 pollId) external view returns (Result memory) {
        return _results[pollId];
    }
}
