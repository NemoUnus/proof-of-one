{
  "name": "@proof-of-one/ballot-circuit",
  "version": "0.1.0",
  "description": "Reference zero-knowledge ballot proof (π_vote) for Proof of One (not for production use)",
  "main": "src/ballot.js",
  "scripts": {
    "build": "mkdir -p build && circom2 circuits/ballot.circom --r1cs --wasm --sym --O2 -o build",
    "setup:test": "bash scripts/setup-test.sh",
    "test": "node --test --test-force-exit test/*.test.js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
